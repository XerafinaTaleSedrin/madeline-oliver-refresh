{% comment %} Category hub — card style: image on top, cream label card below. Brand-driven defaults (cream #F0EBE3, near-black #2C2420, 30px radius). {% endcomment %}
<style>
  .category-hub-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: {{ section.settings.gap }}px;
    padding: {{ section.settings.padding_vertical }}px clamp(1.5rem, 5vw, 4rem);
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }
  @media (min-width: 750px) {
    .category-hub-grid {
      grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    }
  }
  .category-hub-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    background: {{ section.settings.card_background }};
    border-radius: {{ section.settings.card_corner_radius }}px;
    overflow: hidden;
    box-shadow: 0 6px 20px rgba(44, 36, 32, 0.10);
    transition: transform 300ms ease, box-shadow 300ms ease;
  }
  .category-hub-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 28px rgba(44, 36, 32, 0.16);
  }
  .category-hub-card__media {
    position: relative;
    width: 100%;
    aspect-ratio: {{ section.settings.aspect_ratio }};
    overflow: hidden;
  }
  .category-hub-card__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms ease;
  }
  .category-hub-card:hover .category-hub-card__image {
    transform: scale(1.04);
  }
  .category-hub-card__placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #e7e0d6;
  }
  .category-hub-card__body {
    padding: 1.1rem 1rem 1.25rem;
    text-align: center;
  }
  .category-hub-card__label {
    margin: 0;
    font-family: var(--font-body-family), sans-serif;
    font-weight: 500;
    color: {{ section.settings.label_color }};
    font-size: clamp({{ section.settings.label_font_size | times: 0.72 }}rem, 2vw, {{ section.settings.label_font_size }}rem);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1.2;
  }
  .category-hub-section-heading {
    text-align: center;
    font-family: var(--font-heading-family), serif;
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    margin: 0 0 1.5rem;
    padding: 0 1rem;
  }
</style>

{%- if section.settings.heading != blank -%}
  <h2 class="category-hub-section-heading">{{ section.settings.heading }}</h2>
{%- endif -%}

<div class="category-hub-grid">
  {%- for block in section.blocks -%}
    {%- if block.settings.collection != blank and block.settings.collection.all_products_count == 0 -%}
      {%- continue -%}
    {%- endif -%}
    {%- assign tile_loading = 'lazy' -%}
    {%- assign tile_fetchpriority = 'auto' -%}
    {%- if forloop.index <= 3 -%}
      {%- assign tile_loading = 'eager' -%}
    {%- endif -%}
    {%- if forloop.index == 1 -%}
      {%- assign tile_fetchpriority = 'high' -%}
    {%- endif -%}
    {%- assign tile_href = '#' -%}
    {%- if block.settings.collection != blank -%}
      {%- assign tile_href = block.settings.collection.url -%}
    {%- elsif block.settings.link != blank -%}
      {%- assign tile_href = block.settings.link -%}
    {%- endif -%}
    <a href="{{ tile_href }}" class="category-hub-card" {{ block.shopify_attributes }}>
      <div class="category-hub-card__media">
        {%- if block.settings.image != blank -%}
          {{ block.settings.image | image_url: width: 1200 | image_tag: class: 'category-hub-card__image', loading: tile_loading, fetchpriority: tile_fetchpriority, alt: block.settings.label }}
        {%- elsif block.settings.collection != blank and block.settings.collection.image != blank -%}
          {{ block.settings.collection.image | image_url: width: 1200 | image_tag: class: 'category-hub-card__image', loading: tile_loading, fetchpriority: tile_fetchpriority, alt: block.settings.label }}
        {%- elsif block.settings.asset_filename != blank -%}
          <img src="{{ block.settings.asset_filename | asset_url }}" alt="{{ block.settings.label }}" class="category-hub-card__image" loading="{{ tile_loading }}" fetchpriority="{{ tile_fetchpriority }}" width="1200" height="1500">
        {%- else -%}
          <div class="category-hub-card__placeholder">
            {{ 'collection-2' | placeholder_svg_tag: 'category-hub-card__image' }}
          </div>
        {%- endif -%}
      </div>
      <div class="category-hub-card__body">
        <h3 class="category-hub-card__label">{{ block.settings.label }}</h3>
      </div>
    </a>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Category hub grid",
  "tag": "section",
  "class": "section section-category-hub-grid",
  "settings": [
    { "type": "text", "id": "heading", "label": "Section heading" },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Image aspect ratio",
      "options": [
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 5", "label": "Portrait (4:5)" },
        { "value": "3 / 4", "label": "Portrait (3:4)" },
        { "value": "16 / 9", "label": "Landscape (16:9)" }
      ],
      "default": "1 / 1"
    },
    { "type": "range", "id": "columns_desktop", "label": "Desktop columns", "min": 1, "max": 4, "step": 1, "default": 2 },
    { "type": "range", "id": "gap", "label": "Card gap (px)", "min": 0, "max": 80, "step": 2, "default": 32 },
    { "type": "range", "id": "padding_vertical", "label": "Vertical padding (px)", "min": 0, "max": 160, "step": 4, "default": 80 },
    { "type": "range", "id": "max_width", "label": "Max grid width (px)", "min": 800, "max": 1600, "step": 50, "default": 1400 },
    { "type": "header", "content": "Card style" },
    { "type": "range", "id": "card_corner_radius", "label": "Card corner radius (px)", "min": 0, "max": 48, "step": 2, "default": 30 },
    { "type": "color", "id": "card_background", "label": "Card background (cream)", "default": "#F0EBE3" },
    { "type": "color", "id": "label_color", "label": "Label color", "default": "#2C2420" },
    { "type": "range", "id": "label_font_size", "label": "Label size (rem, desktop max)", "min": 1.0, "max": 2.4, "step": 0.1, "default": 1.2 }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "limit": 8,
      "settings": [
        { "type": "text", "id": "label", "label": "Tile label", "default": "Category" },
        { "type": "image_picker", "id": "image", "label": "Tile image" },
        { "type": "text", "id": "asset_filename", "label": "Asset filename (fallback)", "info": "Use a theme asset (e.g. tile-for-her.jpg) when no media-library image is set." },
        { "type": "collection", "id": "collection", "label": "Linked collection", "info": "Tile links to this collection's page. Overrides the URL field below if set." },
        { "type": "url", "id": "link", "label": "Tile link (URL override)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category hub grid",
      "blocks": [
        { "type": "tile", "settings": { "label": "For Her" } },
        { "type": "tile", "settings": { "label": "For Him" } },
        { "type": "tile", "settings": { "label": "For Little Ones" } },
        { "type": "tile", "settings": { "label": "For the Home" } },
        { "type": "tile", "settings": { "label": "Special Occasions" } },
        { "type": "tile", "settings": { "label": "Favorite Brands" } }
      ]
    }
  ]
}
{% endschema %}
