<style>
  .category-hub-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: {{ section.settings.gap }}px;
    padding: {{ section.settings.padding_vertical }}px clamp(1.5rem, 5vw, 4rem);
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }
  @media (min-width: 750px) {
    .category-hub-grid {
      grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    }
  }
  .category-hub-tile {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: {{ section.settings.aspect_ratio }};
    text-decoration: none;
    color: inherit;
    background: rgb(var(--color-background));
    border-radius: {{ section.settings.border_radius }}px;
  }
  .category-hub-tile__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms ease;
  }
  .category-hub-tile:hover .category-hub-tile__image {
    transform: scale(1.04);
  }
  .category-hub-tile__overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    {%- if section.settings.overlay_style == 'white' -%}
      background: linear-gradient(
        180deg,
        rgba(255,255,255,0) {{ section.settings.overlay_start | default: 50 }}%,
        rgba(255,255,255,0.75) {{ section.settings.overlay_start | plus: 25 | default: 75 }}%,
        rgba(255,255,255,0.95) 100%
      );
    {%- else -%}
      background: linear-gradient(180deg, rgba(0,0,0,0) 35%, rgba(0,0,0,0.45) 100%);
    {%- endif -%}
  }
  .category-hub-tile__label {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 1.25rem;
    text-align: center;
    font-family: var(--font-heading-family), serif;
    font-size: clamp(
      {{ section.settings.label_size | times: 0.7 }}rem,
      2.2vw,
      {{ section.settings.label_size }}rem
    );
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0;
    padding: 0 1rem;
    {%- if section.settings.overlay_style == 'white' -%}
      color: rgb(var(--color-foreground));
      text-shadow: 0 1px 6px rgba(255,255,255,0.6);
    {%- else -%}
      color: #fff;
      text-shadow: 0 1px 8px rgba(0,0,0,0.4);
    {%- endif -%}
  }
  .category-hub-tile__placeholder {
    position: absolute;
    inset: 0;
    background: rgb(var(--color-background-2, 240, 235, 227));
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .category-hub-section-heading {
    text-align: center;
    font-family: var(--font-heading-family), serif;
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    margin: 0 0 1.5rem;
    padding: 0 1rem;
  }
</style>

{%- if section.settings.heading != blank -%}
  <h2 class="category-hub-section-heading">{{ section.settings.heading }}</h2>
{%- endif -%}

<div class="category-hub-grid">
  {%- for block in section.blocks -%}
    {%- assign tile_href = '#' -%}
    {%- if block.settings.collection != blank -%}
      {%- assign tile_href = block.settings.collection.url -%}
    {%- elsif block.settings.link != blank -%}
      {%- assign tile_href = block.settings.link -%}
    {%- endif -%}
    <a
      href="{{ tile_href }}"
      class="category-hub-tile"
      {{ block.shopify_attributes }}
    >
      {%- if block.settings.image != blank -%}
        {{ block.settings.image | image_url: width: 1200 | image_tag:
          class: 'category-hub-tile__image',
          loading: 'lazy',
          alt: block.settings.label
        }}
      {%- elsif block.settings.collection != blank and block.settings.collection.image != blank -%}
        {{ block.settings.collection.image | image_url: width: 1200 | image_tag:
          class: 'category-hub-tile__image',
          loading: 'lazy',
          alt: block.settings.label
        }}
      {%- elsif block.settings.asset_filename != blank -%}
        <img
          src="{{ block.settings.asset_filename | asset_url }}"
          alt="{{ block.settings.label }}"
          class="category-hub-tile__image"
          loading="lazy"
          width="1200"
          height="1500"
        >
      {%- else -%}
        <div class="category-hub-tile__placeholder">
          {{ 'collection-2' | placeholder_svg_tag: 'category-hub-tile__image' }}
        </div>
      {%- endif -%}
      <div class="category-hub-tile__overlay"></div>
      <h3 class="category-hub-tile__label">{{ block.settings.label }}</h3>
    </a>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Category hub grid",
  "tag": "section",
  "class": "section section-category-hub-grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Tile aspect ratio",
      "options": [
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 5", "label": "Portrait (4:5)" },
        { "value": "3 / 4", "label": "Portrait (3:4)" },
        { "value": "16 / 9", "label": "Landscape (16:9)" }
      ],
      "default": "4 / 5"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Desktop columns",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Tile gap (px)",
      "min": 0,
      "max": 80,
      "step": 2,
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "label": "Vertical padding (px)",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 80
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max grid width (px)",
      "min": 800,
      "max": 1600,
      "step": 50,
      "default": 1400
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Tile corner radius (px)",
      "min": 0,
      "max": 48,
      "step": 2,
      "default": 16
    },
    {
      "type": "header",
      "content": "Label appearance"
    },
    {
      "type": "select",
      "id": "overlay_style",
      "label": "Overlay style",
      "info": "White fade puts dark text in a soft white band at the bottom — best for varied / bright imagery. Dark fade puts white text over a dark gradient — best for moody / consistent imagery.",
      "options": [
        { "value": "white", "label": "White fade (bottom band, dark text)" },
        { "value": "dark", "label": "Dark fade (overlay, white text)" }
      ],
      "default": "white"
    },
    {
      "type": "range",
      "id": "label_size",
      "label": "Label size (rem, desktop max)",
      "info": "Scales down on smaller screens. Bump up if labels are hard to read on hero imagery.",
      "min": 1.0,
      "max": 3.0,
      "step": 0.1,
      "default": 1.8
    },
    {
      "type": "range",
      "id": "overlay_start",
      "label": "White fade start (% from top)",
      "info": "Only applies to white fade. Higher = narrower white band at bottom. Lower = white fade reaches further up the tile.",
      "min": 30,
      "max": 70,
      "step": 5,
      "default": 50
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "limit": 8,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Tile label",
          "default": "Category"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Tile image"
        },
        {
          "type": "text",
          "id": "asset_filename",
          "label": "Asset filename (fallback)",
          "info": "Use a theme asset (e.g. tile-for-her.jpg) when no media-library image is set."
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Linked collection",
          "info": "Tile links to this collection's page. Overrides the URL field below if set."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Tile link (URL override)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category hub grid",
      "blocks": [
        { "type": "tile", "settings": { "label": "Men" } },
        { "type": "tile", "settings": { "label": "Women" } },
        { "type": "tile", "settings": { "label": "Children" } },
        { "type": "tile", "settings": { "label": "The Home" } },
        { "type": "tile", "settings": { "label": "Gifts" } },
        { "type": "tile", "settings": { "label": "Favorite Brands" } },
        { "type": "tile", "settings": { "label": "Personal Care" } },
        { "type": "tile", "settings": { "label": "Sun Valley Exclusives" } }
      ]
    }
  ]
}
{% endschema %}
