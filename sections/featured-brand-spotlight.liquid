{%- liquid
  assign coll = section.settings.collection
  assign spotlight_image = section.settings.image | default: coll.image
-%}

<div class="brand-spotlight color-{{ section.settings.color_scheme }} gradient">
  <div class="brand-spotlight__inner page-width brand-spotlight--image-{{ section.settings.image_position }}">
    <div class="brand-spotlight__media">
      {%- if spotlight_image != blank -%}
        {{
          spotlight_image
          | image_url: width: 1600
          | image_tag:
            loading: 'lazy',
            sizes: '(min-width: 750px) 50vw, 100vw',
            widths: '400, 600, 800, 1000, 1200, 1600',
            class: 'brand-spotlight__image',
            alt: coll.title
        }}
      {%- else -%}
        {{ 'collection-1' | placeholder_svg_tag: 'brand-spotlight__image placeholder' }}
      {%- endif -%}
    </div>

    <div class="brand-spotlight__content">
      {%- if section.settings.subheading != blank -%}
        <p class="brand-spotlight__subheading">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="brand-spotlight__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="brand-spotlight__text rte">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank and coll != blank -%}
        <a href="{{ coll.url }}" class="button brand-spotlight__button">
          {{ section.settings.button_label | escape }}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .brand-spotlight__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    align-items: center;
    padding-top: 2.5rem;
    padding-bottom: 2.5rem;
  }

  .brand-spotlight__image {
    display: block;
    width: 100%;
    height: auto;
  }

  .brand-spotlight__subheading {
    text-transform: uppercase;
    letter-spacing: 0.1rem;
    font-size: 0.85rem;
    margin: 0 0 0.5rem;
    opacity: 0.75;
  }

  .brand-spotlight__heading {
    margin: 0 0 0.75rem;
  }

  .brand-spotlight__text {
    margin-bottom: 1.5rem;
  }

  .brand-spotlight__button {
    display: inline-block;
  }

  @media screen and (min-width: 750px) {
    .brand-spotlight__inner {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
      padding-top: 4rem;
      padding-bottom: 4rem;
    }

    .brand-spotlight--image-right .brand-spotlight__media {
      order: 2;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Brand spotlight",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image override",
      "info": "Optional. Defaults to the collection's image."
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Featured brand"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Meet the Randimals"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Two animals, one big-hearted message: what makes us different makes all the difference.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Randimals"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Brand spotlight"
    }
  ]
}
{% endschema %}
