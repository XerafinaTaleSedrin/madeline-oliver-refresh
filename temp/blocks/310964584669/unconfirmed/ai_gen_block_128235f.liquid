{% doc %}
  @prompt
    Create a 'Our Story' brand story section for the homepage of a luxury lifestyle boutique called Madeline   Oliver. The section should include:- A warm, premium headline like "20 Years of Curated Living"- A brief 2-3 sentence brand story: Founded in 2005 as Ketchum Bed 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-brand-story-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.padding_top }}px 20px {{ block.settings.padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-brand-story-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: {{ block.settings.content_gap }}px;
    align-items: center;
  }

  @media screen and (min-width: 750px) {
    .ai-brand-story-container-{{ ai_gen_id }} {
      grid-template-columns: {% if block.settings.layout == 'image_left' %}1fr 1fr{% elsif block.settings.layout == 'image_right' %}1fr 1fr{% else %}1fr{% endif %};
      gap: {{ block.settings.content_gap | times: 1.5 }}px;
    }

    .ai-brand-story-container-{{ ai_gen_id }}.ai-layout-image-right-{{ ai_gen_id }} .ai-brand-story-image-wrapper-{{ ai_gen_id }} {
      order: 2;
    }

    .ai-brand-story-container-{{ ai_gen_id }}.ai-layout-image-right-{{ ai_gen_id }} .ai-brand-story-content-{{ ai_gen_id }} {
      order: 1;
    }
  }

  .ai-brand-story-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    position: relative;
  }

  .ai-brand-story-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ block.settings.image_border_radius }}px;
    object-fit: cover;
  }

  .ai-brand-story-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 4 / 3;
    background-color: #f4f4f4;
    border-radius: {{ block.settings.image_border_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-brand-story-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-brand-story-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-brand-story-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.text_spacing }}px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-brand-story-eyebrow-{{ ai_gen_id }} {
    font-size: {{ block.settings.eyebrow_size }}px;
    color: {{ block.settings.eyebrow_color }};
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 500;
    margin: 0;
  }

  .ai-brand-story-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-style: {{ block.settings.heading_font.style }};
    line-height: 1.2;
    margin: 0;
  }

  .ai-brand-story-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
    margin: 0;
  }

  .ai-brand-story-text-{{ ai_gen_id }} p {
    margin: 0 0 1em;
  }

  .ai-brand-story-text-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-brand-story-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    font-weight: 500;
    transition: all 0.3s ease;
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    {% if block.settings.text_alignment == 'center' %}
      margin: 0 auto;
    {% elsif block.settings.text_alignment == 'right' %}
      margin-left: auto;
    {% endif %}
  }

  .ai-brand-story-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_background_hover }};
    color: {{ block.settings.button_text_color_hover }};
    border-color: {{ block.settings.button_border_color_hover }};
  }

  @media screen and (max-width: 749px) {
    .ai-brand-story-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }

    .ai-brand-story-text-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.text_size }}px * 0.95);
    }

    .ai-brand-story-content-{{ ai_gen_id }} {
      text-align: {{ block.settings.mobile_text_alignment }};
    }

    .ai-brand-story-button-{{ ai_gen_id }} {
      {% if block.settings.mobile_text_alignment == 'center' %}
        margin: 0 auto;
      {% elsif block.settings.mobile_text_alignment == 'right' %}
        margin-left: auto;
      {% elsif block.settings.mobile_text_alignment == 'left' %}
        margin-right: auto;
      {% endif %}
    }
  }
{% endstyle %}

<brand-story-{{ ai_gen_id }} class="ai-brand-story-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-brand-story-container-{{ ai_gen_id }} ai-layout-{{ block.settings.layout }}-{{ ai_gen_id }}">
    {% if block.settings.layout != 'text_only' %}
      <div class="ai-brand-story-image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.image %}
          <img
            src="{{ block.settings.image | image_url: width: 1200 }}"
            alt="{{ block.settings.image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.image.width }}"
            height="{{ block.settings.image.height }}"
            class="ai-brand-story-image-{{ ai_gen_id }}"
          >
        {% else %}
          <div class="ai-brand-story-image-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
            <div class="ai-brand-story-empty-state-{{ ai_gen_id }}">
              Add an image to bring your story to life
            </div>
          </div>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-brand-story-content-{{ ai_gen_id }}">
      {% if block.settings.eyebrow != blank %}
        <p class="ai-brand-story-eyebrow-{{ ai_gen_id }}">{{ block.settings.eyebrow }}</p>
      {% endif %}

      {% if block.settings.heading != blank %}
        <h2 class="ai-brand-story-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}

      {% if block.settings.text != blank %}
        <div class="ai-brand-story-text-{{ ai_gen_id }}">{{ block.settings.text }}</div>
      {% endif %}

      {% if block.settings.button_text != blank and block.settings.button_link != blank %}
        <a href="{{ block.settings.button_link }}" class="ai-brand-story-button-{{ ai_gen_id }}">
          {{ block.settings.button_text }}
        </a>
      {% endif %}
    </div>
  </div>
</brand-story-{{ ai_gen_id }}>

<script>
  (function() {
    class BrandStory{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('brand-story-{{ ai_gen_id }}', BrandStory{{ ai_gen_id }});
  })();
</script>

{% schema %}
