{% doc %}
Outputs BreadcrumbList JSON-LD on product and collection pages so search
engines can show a breadcrumb trail in results (lifts click-through).
@example
{% render 'breadcrumb-schema' %}
{% enddoc %}
{%- if request.page_type == 'collection' and collection.url != blank -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": {{ shop.url | json }}
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": {{ collection.title | json }},
          "item": {{ shop.url | append: collection.url | json }}
        }
      ]
    }
  </script>
{%- elsif request.page_type == 'product' -%}
  {%- assign first_collection = product.collections | first -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": {{ shop.url | json }}
        }
        {%- if first_collection != blank -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ first_collection.title | json }},
            "item": {{ shop.url | append: first_collection.url | json }}
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": {{ product.title | json }},
            "item": {{ shop.url | append: product.url | json }}
          }
        {%- else -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ product.title | json }},
            "item": {{ shop.url | append: product.url | json }}
          }
        {%- endif -%}
      ]
    }
  </script>
{%- endif -%}
