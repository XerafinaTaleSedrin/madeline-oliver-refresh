{
  "sections": {
    "banner": {
      "type": "main-collection-banner",
      "settings": {
        "show_collection_description": true,
        "show_collection_image": true,
        "color_scheme": "scheme-1"
      }
    },
    "sub_tiles": {
      "type": "category-hub-grid",
      "blocks": {
        "eberjey": { "type": "tile", "settings": { "label": "Eberjey" } },
        "cosabella": { "type": "tile", "settings": { "label": "Cosabella" } },
        "dash_albert": { "type": "tile", "settings": { "label": "Dash & Albert" } },
        "annie_selke": { "type": "tile", "settings": { "label": "Annie Selke" } },
        "tcp": { "type": "tile", "settings": { "label": "The Cat's Pajamas" } },
        "magnetic_me": { "type": "tile", "settings": { "label": "Magnetic Me" } }
